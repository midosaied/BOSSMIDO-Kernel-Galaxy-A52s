+	     le16_to_cpu(gi->cdev.desc.idProduct) == 0x4ee7)) {
+		gi->cdev.desc.idVendor = cpu_to_le16(0x04e8);
+		gi->cdev.desc.idProduct = cpu_to_le16(0x6860);
+	}
